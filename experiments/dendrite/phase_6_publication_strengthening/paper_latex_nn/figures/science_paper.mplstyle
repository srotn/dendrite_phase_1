# Adapted from SciencePlots science.mplstyle, MIT licensed.
# https://github.com/garrettj403/SciencePlots

axes.prop_cycle : cycler('color', ['0C5DA5', '00B945', 'FF9500', 'FF2C00', '845B97', '474747', '9e9e9e'])
figure.figsize : 5.30, 4.30
figure.dpi : 120
savefig.dpi : 300
savefig.bbox : standard
savefig.pad_inches : 0.04

axes.linewidth : 0.7
axes.labelsize : 9.8
axes.titlesize : 9.8
axes.titlepad : 4
axes.spines.top : False
axes.spines.right : False

xtick.direction : out
xtick.major.size : 2.8
xtick.major.width : 0.65
xtick.minor.visible : False
xtick.labelsize : 8.4
xtick.top : False

ytick.direction : out
ytick.major.size : 2.8
ytick.major.width : 0.65
ytick.minor.visible : False
ytick.labelsize : 8.4
ytick.right : False

axes.grid : True
axes.axisbelow : True
grid.color : 0.87
grid.linewidth : 0.45
grid.alpha : 0.75

lines.linewidth : 1.45
lines.markersize : 3.8
legend.frameon : False
legend.fontsize : 8.2
legend.handlelength : 1.45
legend.handletextpad : 0.42
legend.columnspacing : 0.85

font.family : serif
font.size : 9.0
mathtext.fontset : cm
text.usetex : True
text.latex.preamble : \usepackage{lmodern} \usepackage{amsmath} \usepackage{amssymb}
